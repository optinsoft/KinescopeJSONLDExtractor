{
  "manifest_version": 3,
  "name": "Kinescope JSON-LD Extractor PRO",
  "version": "4.5",
  "description": "Bypassing CSP and intercepting MP4/JSON-LD links in Kinescope",
  "permissions": ["tabs", "scripting", "downloads"],
  "host_permissions": [
    "<all_urls>"
  ],  
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
	    "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}